  "measurement_workflows": {
    "IVL": "Voltage/current/light sweep and pixel status classification; opening voltage uses a dedicated photodiode-current threshold and a configurable number of following above-threshold points. The modular workflow writes raw CSV during measurement and builds final XLSX after processing. BURNED is final only when the confirmation outcome is nonworking. One latest thumbnail per pixel is stored with every series thumbnail under <series>/thumbnails, uses a shared linear current scale with live-graph colors, and missing, legacy or older-than-workbook renders are refreshed by the Refresh button and on hover.",
    "SPECTRUM": "Spectral measurement with pixel/substrate/explicit-priority-queue selection, chosen queue start, queued-only sequential completion, live integration-time previews, electrical checks before and after every T_int trial, same-pixel NO_CONTACT retry, and burnout-threshold CURRENT_LIMIT diagnostics that may be journaled before same-quarter replacement; CIE/BPW34 recalculation runs separately and stores integral_calibration.json plus SPECTRAL_RECALC_*.xlsx under <series>/calibration/<quarter> without modifying the source workbook.",
    "STABILITY": "Mutable constant-current feedback or immediate constant-voltage stability measurement; raw CSV and final XLSX retain target and applied values."
  },
  "git": {
    "primary_remote": "oled_app",
    "fallback_git_dir": ".git-local",
    "ignored_local_data": [
