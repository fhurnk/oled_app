[Unit]
Description=OLED Canon camera service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/oled-camera
ExecStart=/home/user/oled-camera/.venv/bin/python /home/user/oled-camera/camera_service.py --config /home/user/oled-camera/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
